APP_NAME=RAG Research & Evaluation Framework
APP_ENV=local
DATABASE_URL=sqlite:///./artifacts/rag_eval.db
ARTIFACT_DIR=./artifacts
DATA_DIR=./data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
CHUNK_SIZE=700
CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
MAX_UPLOAD_MB=20
# demo = extractive answers, no API key needed. openai_compatible = real LLM (Groq, OpenAI, ...)
LLM_MODE=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LOG_LEVEL=INFO
